# Local PostgreSQL development settings only. Copy to .env and do not commit it.
POSTGRES_DB=agentic_commerce
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic_local
POSTGRES_PORT=5433

DB_URL=jdbc:postgresql://localhost:5433/agentic_commerce
DB_USERNAME=agentic
DB_PASSWORD=agentic_local

# Use true for HTTPS deployments. Local HTTP development uses false.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m

# Provider credentials are blank placeholders only.
# SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ENABLED=false
CATALOGUE_EMBEDDING_ENABLED=false
OPEN_FOOD_FACTS_ENABLED=false
# Optional trusted-demo merchant account-link fixture. Disabled by default.
MERCHANT_LINK_DEMO_ENABLED=false
MERCHANT_LINK_DEMO_USERNAME=
MERCHANT_LINK_DEMO_PASSWORD=
# Razorpay Payments Test Mode (server-side only; never expose secrets to the browser)
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_CONFIGURATION_REFERENCE=razorpay-test-default
RAZORPAY_TEST_ACCOUNT_REFERENCE=default-test-account
