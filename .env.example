# Local PostgreSQL development settings only. Copy to .env and do not commit it.
POSTGRES_DB=agentic_commerce
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic_local
POSTGRES_PORT=5433

DB_URL=jdbc:postgresql://localhost:5433/agentic_commerce
DB_USERNAME=agentic
DB_PASSWORD=agentic_local

# Use true for HTTPS deployments. Local HTTP development uses false.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m

# Future provider credentials are intentionally absent from Task 000.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SARVAM_API_KEY=
# GEMINI_API_KEY=
