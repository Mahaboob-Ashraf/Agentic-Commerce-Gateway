# Local PostgreSQL development settings only. Copy to .env and do not commit it.
POSTGRES_DB=agentic_commerce
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic_local
POSTGRES_PORT=5433

DB_URL=jdbc:postgresql://localhost:5433/agentic_commerce
DB_USERNAME=agentic
DB_PASSWORD=agentic_local

# Use true for HTTPS deployments. Local HTTP development uses false.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m

# Provider credentials are blank placeholders only.
# SARVAM_API_KEY=
GEMINI_API_KEY=
# Workload-specific Buyer models are isolated from the legacy generic model.
GEMINI_BUYER_INTENT_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_AGENTIZATION_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_MODEL remains a legacy fallback for agentization tasks only.
# GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=false
GEMINI_VISION_ENABLED=false
CATALOGUE_EMBEDDING_ENABLED=false
OPEN_FOOD_FACTS_ENABLED=false
# Optional trusted-demo merchant account-link fixture. Disabled by default.
MERCHANT_LINK_DEMO_ENABLED=false
MERCHANT_LINK_DEMO_USERNAME=
MERCHANT_LINK_DEMO_PASSWORD=
# Required only for the opt-in public HTTPS demo-merchant bootstrap and executor.
DEMO_MERCHANT_API_SECRET=
DEMO_BOOTSTRAP_ENABLED=false
DEMO_MERCHANT_PUBLIC_BASE_URL=
DEMO_BUYER_IDENTITY=
DEMO_BUYER_PASSWORD=
# Optional public reviewer-only Buyer credentials. These are embedded in the web
# bundle by design; never place a production or non-demo secret here.
NEXT_PUBLIC_DEMO_BUYER_IDENTITY=
NEXT_PUBLIC_DEMO_BUYER_PASSWORD=
# Razorpay Payments Test Mode (server-side only; never expose secrets to the browser)
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_CONFIGURATION_REFERENCE=razorpay-test-default
RAZORPAY_TEST_ACCOUNT_REFERENCE=default-test-account
