{
  "name": "agentic-commerce-gateway",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "24.19.x",
    "pnpm": "10.15.0"
  },
  "scripts": {
    "web:dev": "pnpm --filter @agentic-commerce/web dev",
    "web:lint": "pnpm --filter @agentic-commerce/web lint",
    "web:typecheck": "pnpm --filter @agentic-commerce/web typecheck",
    "web:build": "pnpm --filter @agentic-commerce/web build",
    "web:test": "node scripts/run-web-tests.mjs",
    "web:check": "pnpm web:lint && pnpm web:typecheck && pnpm web:build",
    "proof:datasets": "node scripts/evidence.mjs validate",
    "proof:safety": "node scripts/run-evidence.mjs safety",
    "proof:mutation": "node scripts/run-evidence.mjs mutation",
    "proof:adversarial": "node scripts/run-evidence.mjs adversarial",
    "proof:concurrency": "node scripts/run-evidence.mjs concurrency",
    "proof:latency": "node scripts/run-evidence.mjs latency",
    "proof:evaluate:retrieval": "node scripts/run-evidence.mjs retrieval",
    "proof:evaluate:intent": "node scripts/run-evidence.mjs intent",
    "proof:evaluate:multilingual": "node scripts/run-evidence.mjs multilingual",
    "proof:verify": "node scripts/run-evidence.mjs verify",
    "proof:evaluate": "pnpm proof:evaluate:retrieval && pnpm proof:evaluate:intent"
  }
}

